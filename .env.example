# ReelVault Environment Configuration Example

# Directory configuration (local-first scanning)
REELS_FOLDER=/absolute/path/to/reels
DATABASE_PATH=./data/reelvault.db
THUMBNAILS_FOLDER=./data/thumbnails

# AI Configuration (Gemini API)
# Leave GEMINI_API_KEY blank if you don't want to use AI features.
# The app will run in fallback offline mode gracefully.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server details
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_PORT=5173
