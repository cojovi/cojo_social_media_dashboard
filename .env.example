# ReelVault local configuration. Keep the database and thumbnails outside cloud sync.
# On this Mac the intended source is:
# /Users/cojovi/Library/Mobile Documents/com~apple~CloudDocs/SnapIGTik Download
# If omitted, this iCloud folder is auto-detected when present; otherwise ./reels.
REELS_FOLDER=/absolute/path/to/SnapIGTik Download
DATABASE_PATH=./data/reelvault.db
THUMBNAILS_FOLDER=./data/thumbnails

GEMINI_API_KEY=
# Full video + audio review and caption suggestions, requested explicitly.
GEMINI_MODEL=gemini-2.5-flash
# Inexpensive, visual-only organizational descriptions.
QUICK_SUMMARY_MODEL=gemini-2.5-flash-lite
AUTO_SCAN=true
SCAN_INTERVAL_SECONDS=900
AUTO_QUICK_SUMMARY=true
FILE_SETTLE_SECONDS=60
QUICK_SUMMARY_DELAY_SECONDS=4
# Estimated paid-tier spending for quick descriptions per UTC day.
# 0 stops new quick requests. Not an account-wide Google billing cap.
QUICK_SUMMARY_DAILY_BUDGET_USD=1

APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_PORT=5173

# Hosted mode (local remains the default). Never expose an unauthenticated server.
STORAGE_PROVIDER=local
AUTH_REQUIRED=false
ADMIN_TOKEN=
AGENT_TOKEN=
PUBLIC_ORIGIN=http://127.0.0.1:18765
COOKIE_SECURE=true
MAX_CONCURRENT_DOWNLOADS=5
CACHE_MAX_BYTES=5000000000
CACHE_TTL_SECONDS=43200
# Small derived previews live in data/previews, separately from original media.
# One encoder, <=1 MB per silent 9-second clip; backfill waits at this budget.
AUTO_PREVIEWS=true
PREVIEW_MAX_BYTES=1000000000
PREVIEW_DELAY_SECONDS=10
MIN_FREE_DISK_BYTES=5000000000
# CACHE_FOLDER defaults beside DATABASE_PATH; FRONTEND_DIST defaults to frontend/dist.
# Exactly one hosting process owns the cache and its durable workers.
VM_JOBS_ENABLED=true
